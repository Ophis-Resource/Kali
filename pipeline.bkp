# Azure DevOps Pipeline - Full VAPT Toolchain
# Each tool is its own stage, runs independently.

trigger:
  - main

# parameters:
#   - name: target
#     type: string
#     default: 'example.com'

parameters:
  - name: target
    type: string
    default: 'example.com'
  - name: authorized
    type: boolean
    default: false   # <-- must be set to true in pipeline run to enable intrusive tools

variables:
  projectPath: /home/azureuser/Project_3D_VAPT

# --- Stage 1: Setup ---
stages:
  - stage: Setup
    displayName: "Setup: Clone Repository"
    jobs:
      - deployment: CloneRepo
        displayName: 'Clone or Update VAPT Repository'
        environment:
          name: Kali
          resourceType: virtualMachine
        strategy:
          runOnce:
            deploy:
              steps:
                - script: |
                    cd /home/azureuser
                    if [ -d "Project_3D_VAPT" ]; then
                      echo "Repository exists. Pulling latest changes..."
                      cd Project_3D_VAPT && git reset --hard HEAD && git clean -fdx && git pull
                    else
                      echo "Cloning new repository..."
                      git clone https://dev.azure.com/devsandbox2/Project%203D%20VAPT/_git/Project%203D%20VAPT Project_3D_VAPT
                    fi
                  displayName: "Clone or Update Repository"
                  env:
                    GIT_CONFIG_PARAMETERS: "'http.https://dev.azure.com.extraheader'='AUTHORIZATION: bearer $(System.AccessToken)'"

# --- Tool Stages ---
  - stage: Whois
    jobs:
      - deployment: WhoisJob
        environment: { name: Kali, resourceType: virtualMachine }
        strategy:
          runOnce:
            deploy:
              steps:
                - script: cd $(projectPath)/tools && chmod +x whois_scan_full.sh && ./whois_scan_full.sh ${{ parameters.target }}
                  displayName: "Run Whois"

  - stage: Ping
    jobs:
      - deployment: PingJob
