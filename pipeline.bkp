# --- Final Stage: Publish Results ---
  - stage: PublishArtifacts
    dependsOn: 
      - Whois
      - Ping
      - Nslookup
      - WhatWeb
      - Nmap
      # - Nikto
      # - Nuclei
      - Gobuster
      # - Dirb
      # - Dirsearch
      - SSLScan
      # - OpenSSL
      - Dig
      # - DNSEnum
      # - Findomain
      # - Sublist3r
      # - TheHarvester
      - Traceroute
      - SQLMap
      - Commix
      - DotDotPwn
      - NoSQLMap
      - Sniper
    jobs:
      - deployment: Publish
        environment: { name: Kali, resourceType: virtualMachine }
        strategy:
          runOnce:
            deploy:
              steps:
                - script: |
                    ARTIFACT_DIR="$(projectPath)/artifact_output"
                    mkdir -p "$ARTIFACT_DIR"
                    echo "Collecting all scan results..."
                    cp $(projectPath)/tools/output/*_output.txt "$ARTIFACT_DIR/" 2>/dev/null || echo "No primary text files."
                    cp $(projectPath)/tools/output/json/*.json "$ARTIFACT_DIR/" 2>/dev/null || echo "No JSON files."
                    COMBINED_FILE="$ARTIFACT_DIR/combined_output.txt"
                    echo "### Combined Output for ${{ parameters.target }}" > "$COMBINED_FILE"
                    for f in "$ARTIFACT_DIR"/*_output.txt; do
                      echo -e "\n\n--- START $(basename "$f") ---\n" >> "$COMBINED_FILE"
                      cat "$f" >> "$COMBINED_FILE"
                      echo -e "\n--- END $(basename "$f") ---" >> "$COMBINED_FILE"
                    done
                  displayName: "Collect Outputs"
                - task: PublishPipelineArtifact@1
                  inputs:
                    targetPath: '$(projectPath)/artifact_output'
                    artifact: 'VAPT-Scan-Results'
                  displayName: 'Publish Artifact'
